# ==============================
# App
# ==============================
APP_NAME=SmartAudit-AI Python Service
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
# Required: set to the same value as SMARTAUDIT_AI_INTERNAL_TOKEN.
INTERNAL_API_TOKEN=not-a-secret
RAG_V3_ENABLED=true
PARENT_CHILD_ENABLED=true
LEGAL_BM25_ENABLED=true
RISK_QUERY_BUILDER_ENABLED=true
RRF_ENABLED=true
RERANK_ENABLED=true
LLM_JUDGE_ENABLED=true
FINAL_CHECK_ENABLED=true
RAG_EVAL_ENABLED=false

JUDGE_MODE=observe
JUDGE_REJECT_POLICY=soft
STRICT_TENANT_ISOLATION=false
TENANT_FILTER_REQUIRED=true

# ==============================
# Agent2 execution mode
# workflow: fixed reviewer chain (stable default)
# react: tool-augmented ReAct reviewer with budget & fallback
# ==============================
AGENT2_MODE=react
REACT_MAX_STEPS=4
REACT_MAX_TOOL_CALLS=6
REACT_TOOL_TIMEOUT_MS=1200
REACT_RETRY_STRICT_ONCE=true
REACT_STRICT_MAX_STEPS=6
REACT_STRICT_MAX_TOOL_CALLS=8
REACT_REQUIRE_EVIDENCE_BEFORE_FINAL=true
REACT_MIN_EVIDENCE_TOOL_CALLS=1
REACT_DROP_UNMATCHED_EXCERPT=true
REACT_AUTOFILL_LEGAL_BASIS=true
REACT_TRACE_ENABLED=true
REACT_TRACE_INCLUDE_DETAIL=false
REACT_TRACE_DIR=logs/react-traces
REACT_USE_NATIVE_TOOL_CALLING=true
REACT_FINAL_ALLOW_TOOLS=false
REACT_FINALIZE_ON_BUDGET_EXHAUST=true
REACT_OBS_MAX_CHARS=1200
REACT_OBS_TOPK_CAP=2
FALLBACK_REVIEW_CONTEXT_CHARS=6000
FALLBACK_WORKFLOW_SINGLE_PASS=true

# ==============================
# LLM (OpenAI-compatible)
# DeepSeek OpenAI-compatible API
LLM_PROVIDER=deepseek
# ==============================
DEEPSEEK_API_KEY=<REQUIRED_DEEPSEEK_API_KEY>
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash
RERANK_MODEL_PATH=models/bge-reranker-v2-m3
RERANK_MODEL_VERSION=bge-reranker-v2-m3
RERANK_ENABLED=true
RERANK_TOP_N=10
RERANK_BATCH_SIZE=8
RERANK_MAX_LENGTH=512
RERANK_TIMEOUT_MS=3000

LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=60
MAX_CONTRACT_CHARS=40000

# ==============================
# Map-Reduce + 轻量 RAG 参数
# ==============================
MAP_CHUNK_PAGES=10
MAP_CHUNK_OVERLAP_PAGES=1
MAP_MAX_CONCURRENCY=4
REVIEW_CONTEXT_CHARS=50000
RAG_TOP_K_PER_QUERY=2
RAG_MAX_CHARS=12000

# ==============================
# Embedding Vector RAG (bge-m3 + Chroma)
# ==============================
# rag mode: keyword | vector | hybrid
RAG_MODE=hybrid

# local embedding model path (for pure local deployment)
EMBEDDING_MODEL_PATH=models/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_NORMALIZE=true
EMBEDDING_BATCH_SIZE=16

# vector retrieval params
VECTOR_CHUNK_SIZE=900
VECTOR_CHUNK_OVERLAP=120
VECTOR_TOP_K=3
VECTOR_MAX_CHARS=10000

# chroma local persistence
CHROMA_PERSIST_DIR=storage/chroma
CHROMA_COLLECTION_PREFIX=smartaudit-task
VECTOR_REINDEX_EACH_RUN=true

# ==============================
# Callback
# ==============================
CALLBACK_TIMEOUT_SECONDS=15
CALLBACK_RETRY_TIMES=3
CALLBACK_RETRY_INTERVAL_SECONDS=2
CALLBACK_VERIFY_SSL=true
CALLBACK_SIGNATURE_ENABLED=true
# Required when callback signatures are enabled; use the Java-side signature secret.
CALLBACK_SIGNATURE_SECRET=not-a-secret
