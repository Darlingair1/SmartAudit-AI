# ==============================
# SmartAudit-AI unified runtime env
# Copy this file to `env.deploy` at project root and fill real values.
# ==============================

# -------- MySQL --------
DB_URL=jdbc:mysql://127.0.0.1:3306/smartaudit_ai?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USER=root
DB_PASS=<REQUIRED_DB_PASSWORD>

# -------- Java security (P0 required) --------
SPRING_PROFILES_ACTIVE=prod
SMARTAUDIT_STRICT_AUTH_ENABLED=true
SMARTAUDIT_FAIL_ON_DEFAULT_SECRETS=true
SMARTAUDIT_JWT_SECRET=<REQUIRED_RANDOM_JWT_SECRET_MIN_32_CHARS>
SMARTAUDIT_CALLBACK_TOKEN=<REQUIRED_RANDOM_CALLBACK_TOKEN>
SMARTAUDIT_AI_INTERNAL_TOKEN=<REQUIRED_RANDOM_INTERNAL_TOKEN>
SMARTAUDIT_CALLBACK_SIGNATURE_SECRET=<REQUIRED_RANDOM_SIGNATURE_SECRET>
# Used only when the user table is empty. Remove it after the first successful login.
SMARTAUDIT_BOOTSTRAP_ADMIN_USERNAME=admin
SMARTAUDIT_BOOTSTRAP_ADMIN_PASSWORD=<REQUIRED_INITIAL_ADMIN_PASSWORD_MIN_12_CHARS>

# -------- Java AI defaults --------
SMARTAUDIT_DEFAULT_MODEL=deepseek-v4-flash

# -------- Python LLM --------
APP_ENV=production
# DEEPSEEK_API_KEY is read from your local system environment.
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
RERANK_MODEL_PATH=models/bge-reranker-v2-m3
RERANK_MODEL_VERSION=bge-reranker-v2-m3
RERANK_ENABLED=true
RERANK_TOP_N=10
RERANK_BATCH_SIZE=8
RERANK_MAX_LENGTH=512
RERANK_TIMEOUT_MS=3000

# -------- Python internal auth / callback signature --------
# Keep them consistent with Java-side values above.
INTERNAL_API_TOKEN=<SAME_AS_SMARTAUDIT_AI_INTERNAL_TOKEN>
CALLBACK_SIGNATURE_ENABLED=true
CALLBACK_SIGNATURE_SECRET=<SAME_AS_SMARTAUDIT_CALLBACK_SIGNATURE_SECRET>
CALLBACK_TIMEOUT_SECONDS=15
CALLBACK_RETRY_TIMES=3
CALLBACK_RETRY_INTERVAL_SECONDS=2

# -------- Data retention --------
SMARTAUDIT_RETENTION_ENABLED=true
SMARTAUDIT_RETENTION_DAYS=90
SMARTAUDIT_RETENTION_CRON=0 30 2 * * *

# -------- Optional tuning --------
AGENT2_MODE=react
RAG_MODE=hybrid
RAG_V3_ENABLED=true
PARENT_CHILD_ENABLED=true
LEGAL_BM25_ENABLED=true
RISK_QUERY_BUILDER_ENABLED=true
RRF_ENABLED=true
RERANK_ENABLED=true
LLM_JUDGE_ENABLED=true
FINAL_CHECK_ENABLED=true
REACT_TRACE_INCLUDE_DETAIL=false
JUDGE_MODE=observe
JUDGE_REJECT_POLICY=soft
